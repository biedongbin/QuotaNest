{
  "name": "qoder",
  "displayName": "Qoder 国际",
  "label": "Qoder 国际",
  "icon": "logo-mono:qoder",
  "accent": "blue",
  "enabled": true,
  "autoCreateDefault": false,
  "authFile": "~/.claude/hud/.qoder-usage-auth.json",
  "cacheFile": "~/.claude/hud/.qoder-usage-cache.json",
  "fetch": "./fetch.sh",
  "intervalSec": 60,
  "needsCredential": false,
  "authMode": "auth",
  "quotaAuthModes": [
    "auth"
  ],
  "queryAuth": "header",
  "quotaMode": "script",
  "inheritQueryUrl": "https://openapi.qoder.sh/api/v2/quota/usage",
  "inheritQueryHeader": "Authorization: Bearer <key>\nAccept: application/json",
  "credentialSource": {
    "file": "",
    "tokenPath": "accessToken",
    "requiredValues": {
      "provider": "qoder"
    },
    "contextPaths": {
      "sourceProvider": "provider",
      "expiresAt": "expiresAt",
      "region": "providerSpecificData.region",
      "userId": "providerSpecificData.userId",
      "machineId": "providerSpecificData.machineId",
      "authMethod": "providerSpecificData.authMethod"
    },
    "alternatives": [
      {
        "tokenPath": "apiKey",
        "requiredValues": {
          "provider": "qoder"
        },
        "contextPaths": {
          "sourceProvider": "provider",
          "expiresAt": "expiresAt",
          "region": "providerSpecificData.region",
          "userId": "providerSpecificData.userId",
          "machineId": "providerSpecificData.machineId",
          "authMethod": "providerSpecificData.authMethod"
        }
      }
    ]
  },
  "buckets": {}
}
