{
  "name": "vercel-ai-gateway",
  "displayName": "Vercel AI Gateway",
  "label": "VG",
  "icon": "globe",
  "accent": "blue",
  "enabled": true,
  "autoCreateDefault": false,
  "authFile": "~/.claude/hud/.vercel-ai-gateway-usage-auth.json",
  "cacheFile": "~/.claude/hud/.vercel-ai-gateway-usage-cache.json",
  "fetch": "./fetch.sh",
  "intervalSec": 60,
  "needsCredential": false,
  "authMode": "apikey",
  "quotaAuthModes": [
    "apikey"
  ],
  "queryAuth": "bearer",
  "quotaMode": "script",
  "inheritQueryUrl": "https://ai-gateway.vercel.sh/v1/credits",
  "inheritQueryHeader": "Authorization: Bearer <key>\nAccept: application/json",
  "refreshAuth": "bearer",
  "refreshHeader": "Authorization: Bearer <key>",
  "refreshProtocol": "openai",
  "refreshUrl": "https://ai-gateway.vercel.sh/v1/chat/completions",
  "testModel": "",
  "buckets": {}
}
