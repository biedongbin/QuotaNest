{
  "name": "officeace",
  "displayName": "OfficeAce",
  "label": "OfficeAce",
  "icon": "logo:officeace",
  "accent": "blue",
  "enabled": true,
  "autoCreateDefault": false,
  "authFile": "~/.claude/hud/.officeace-usage-auth.json",
  "cacheFile": "~/.claude/hud/.officeace-usage-cache.json",
  "fetch": "./fetch.sh",
  "intervalSec": 60,
  "needsCredential": false,
  "authMode": "auth",
  "quotaAuthModes": [
    "auth"
  ],
  "queryAuth": "bearer",
  "quotaMode": "script",
  "inheritQueryUrl": "https://officeace.cn-southwest-2.huaweicloud-agentarts.com/v1/subscription",
  "credentialSource": {
    "file": "",
    "tokenPath": "access_key_id",
    "contextPaths": {
      "secretAccessKey": "secret_access_key",
      "securityToken": "security_token",
      "projectId": "project_id"
    },
    "alternatives": [
      {
        "tokenPath": "access",
        "contextPaths": {
          "secretAccessKey": "secret",
          "securityToken": "securityToken",
          "projectId": "projectId"
        }
      },
      {
        "tokenPath": "credentials.access_key_id",
        "contextPaths": {
          "secretAccessKey": "credentials.secret_access_key",
          "securityToken": "credentials.security_token",
          "projectId": "credentials.project_id"
        }
      }
    ]
  },
  "buckets": {}
}
