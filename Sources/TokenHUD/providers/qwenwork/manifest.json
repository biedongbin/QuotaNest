{
  "name": "qwenwork",
  "displayName": "QwenWork",
  "label": "QwenWork",
  "icon": "logo:qwen-color",
  "accent": "blue",
  "enabled": true,
  "autoCreateDefault": false,
  "authFile": "~/.claude/hud/.qwenwork-usage-auth.json",
  "cacheFile": "~/.claude/hud/.qwenwork-usage-cache.json",
  "fetch": "./fetch.sh",
  "intervalSec": 60,
  "needsCredential": false,
  "authMode": "auth",
  "quotaAuthModes": [
    "auth"
  ],
  "queryAuth": "bearer",
  "quotaMode": "script",
  "inheritQueryUrl": "https://gateway.qwenwork.cn/api/v1/adapter/user/account-context?include=user,plan,quota",
  "credentialSource": {
    "file": "",
    "tokenPath": "deviceToken",
    "contextPaths": {
      "enterpriseHost": "enterpriseHost"
    },
    "alternatives": [
      {
        "tokenPath": "access",
        "requiredValues": {
          "type": "qwenwork"
        },
        "contextPaths": {
          "enterpriseHost": "enterpriseHost"
        }
      }
    ]
  },
  "buckets": {}
}
